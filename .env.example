# Copy to .env and edit. Environment variables override this file.
JWT_SECRET=change-me-to-a-long-random-string
DATA_ENCRYPTION_KEY=use-a-stable-random-encryption-secret
# DEV ONLY - returns OTP codes in API responses and serves SAMPLE (unreviewed) statutes
DEBUG_RETURN_OTP=true
OTP_MINUTES=1
ALLOW_UNREVIEWED_STATUTES=true
# Chatbot: mock (offline, no key needed) or anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Firebase client config is read from google-services (1).json.
# Server-side Firebase Admin features require one of these credentials:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set this to a real service-account JSON file outside the repository:
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
FIREBASE_STORAGE_BUCKET=legalshield-f4990.firebasestorage.app
# Optional: Firebase Cloud Messaging Web Push VAPID key
FIREBASE_WEB_VAPID_KEY=
